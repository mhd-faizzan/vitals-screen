<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0a0a0f"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⚡ VITALS SCREEN"
        android:textColor="#FF00FF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:letterSpacing="0.2"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="REAL-TIME BIOMETRIC MONITOR"
        android:textColor="#555577"
        android:textSize="10sp"
        android:gravity="center"
        android:letterSpacing="0.3"
        android:paddingBottom="12dp"/>

    <com.presagetech.smartspectra.SmartSpectraView
        android:id="@+id/smart_spectra_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="#12122a"
            android:padding="14dp"
            android:layout_marginEnd="6dp">

            <TextView
                android:text="❤ HEART RATE"
                android:textColor="#00FFFF"
                android:textSize="9sp"
                android:letterSpacing="0.2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/tv_heart_rate"
                android:text="--"
                android:textColor="#FF00FF"
                android:textSize="32sp"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:text="bpm"
                android:textColor="#555577"
                android:textSize="10sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="#12122a"
            android:padding="14dp"
            android:layout_marginStart="6dp">

            <TextView
                android:text="🫁 BREATHING"
                android:textColor="#00FFFF"
                android:textSize="9sp"
                android:letterSpacing="0.2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/tv_breathing_rate"
                android:text="--"
                android:textColor="#FF00FF"
                android:textSize="32sp"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:text="bpm"
                android:textColor="#555577"
                android:textSize="10sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#12122a"
            android:padding="14dp">

            <TextView
                android:text="📊 STATUS"
                android:textColor="#00FFFF"
                android:textSize="9sp"
                android:letterSpacing="0.2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/tv_status"
                android:text="READY"
                android:textColor="#00FF41"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>